# 复制为 .env 后填写。所有 Key 均为空值模板，切勿把真实 Key 提交到仓库。

# ===== OpenAI 兼容大模型接口（用于蒸馏 / 网页总结 / 评估）=====
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com"

# 网页总结模型（visit 工具抽取网页信息用）
LLM_MODEL_ID="deepseek-v4-flash"

# 蒸馏模型（生成训练轨迹的强模型）
AGENT_MODEL_ID="MiniMax-M3"

# Reward 答案打分模型（RL 训练中 LLM-Judge）
JUDGE_MODEL_ID="deepseek-v4-flash"

# ===== 工具后端 API Key =====
# 高德地图开放平台（weather_search / poi_search / around_search / route_planning）
AMAP_MAPS_API_KEY=""

# FireCrawl（tool_web_search.py 的 search、tool_visit.py 的 visit）
FIRECRAWL_API_KEY=""

# Tavily（tool_tavily_visit.py，search/visit 的备选实现）
TAVILY_API_KEY=""

# SerpApi / Serper（tool_google_web_search.py）
SERPAPI_API_KEY=""
